{
  "productName": "Seedance Forge v3.1",
  "version": "3.1.0",
  "identifier": "com.seedance.forge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Seedance Forge v3.1", "width": 1600, "height": 1000, "minWidth": 1280, "minHeight": 720 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
